i.","Dodaj paprykę mieloną i szpinak, a następnie smaż, aż szpinak zwiędnie.","Roztrzep jajka z serkiem wiejskim i solą, po czym wlej masę na patelnię. Dodaj brokuł i delikatnie wymieszaj składniki.","Piecz przez 15–18 minut, aż jajka się zetną, a przed podaniem odstaw na chwilę."],"prepMinutes":15,"cookMinutes":25,"difficulty":"medium","cuisine":null,"allergens":["dairy","eggs"],"nutritionPerServing":{"calories":291,"protein":29,"fat":16,"carbs":9},"origin":"seed","byModel":null,"source":null},"servings":1.25,"before":{"calories":344,"protein":17,"fat":11,"carbs":51},"after":{"calories":364,"protein":36,"fat":20,"carbs":11},"dayBefore":{"calories":1598,"protein":115,"fat":62,"carbs":161},"dayAfter":{"calories":1618,"protein":134,"fat":71,"carbs":121},"calorieTarget":1600,"revision":0}