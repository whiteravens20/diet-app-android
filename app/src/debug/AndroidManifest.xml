<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only overlay: the emulator default API_BASE_URL (http://10.0.2.2:4000)
     is cleartext, which Android 9+ blocks unless opted in. Release builds keep
     the platform default (cleartext blocked). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:usesCleartextTraffic="true" />
</manifest>
